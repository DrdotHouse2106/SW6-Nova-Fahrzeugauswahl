<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSwitcherConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSelectionStorage">
            <argument type="service" id="request_stack"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Service\VehicleOptionLoader">
            <argument type="service" id="property_group_option.repository"/>
            <argument type="service" id="product.repository"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Subscriber\HeaderPageletSubscriber">
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSwitcherConfig"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleOptionLoader"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSelectionStorage"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Subscriber\FooterPageletSubscriber">
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSwitcherConfig"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleOptionLoader"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSelectionStorage"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Subscriber\NavigationPageSubscriber">
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSwitcherConfig"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleOptionLoader"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSelectionStorage"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Service\CategoryVehicleFilter">
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service" id="Shopware\Core\Content\ProductStream\Service\ProductStreamBuilder"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Subscriber\NavigationTreeSubscriber">
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSwitcherConfig"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSelectionStorage"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\CategoryVehicleFilter"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Subscriber\ProductListingSubscriber">
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSwitcherConfig"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSelectionStorage"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Subscriber\VehicleQuerySubscriber">
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSwitcherConfig"/>
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleOptionLoader"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Ulber\FahrzeugSchnellauswahl\Subscriber\CacheKeySubscriber">
            <argument type="service" id="Ulber\FahrzeugSchnellauswahl\Service\VehicleSelectionStorage"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
