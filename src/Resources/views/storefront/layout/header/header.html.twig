{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{#
    Fügt die horizontale Fahrzeug-Schnellauswahl direkt unter dem Header ein.
    Die Extension wird im HeaderPageletSubscriber gesetzt.
    Achtung: Die Pagelet-Variable heißt hier `header`, nicht `page.header`.
#}
{% block layout_header %}
    {{ parent() }}

    {% set vehicleSwitcher = header.extensions.vehicleSwitcher ?? null %}
    {% set vehicleSwitcherStatus = header.extensions.vehicleSwitcherStatus ?? null %}
    {% if vehicleSwitcherStatus %}<!-- Nova Fahrzeugauswahl: {{ vehicleSwitcherStatus.get('text') }} -->{% endif %}
    {% for timingKey in ['vehicleSwitcherOptionsTiming', 'vehicleSwitcherTiming'] %}
        {% if header.extensions[timingKey] is defined %}<!-- Nova Fahrzeugauswahl: {{ header.extensions[timingKey].get('text') }} -->{% endif %}
    {% endfor %}

    {% if vehicleSwitcher and vehicleSwitcher.options.count > 0 %}
        {% sw_include '@Storefront/storefront/component/vehicle-switcher/vehicle-switcher.html.twig' with {
            options: vehicleSwitcher.options,
            activeOptionId: vehicleSwitcher.activeOptionId,
            showAllOption: vehicleSwitcher.showAllOption,
            allOptionLabel: vehicleSwitcher.allOptionLabel,
            groupLabels: vehicleSwitcher.groupLabels,
            groupOrder: vehicleSwitcher.groupOrder,
            layout: vehicleSwitcher.layout,
            displayLabels: vehicleSwitcher.displayLabels,
            activeDescription: vehicleSwitcher.activeDescription,
            descriptionListingOnly: vehicleSwitcher.descriptionListingOnly,
            descriptionCssClass: vehicleSwitcher.descriptionCssClass,
            more: header.extensions.vehicleSwitcherMore ?? null
        } %}
    {% endif %}
{% endblock %}
