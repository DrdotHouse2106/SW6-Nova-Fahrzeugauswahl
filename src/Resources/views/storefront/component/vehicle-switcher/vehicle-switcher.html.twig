{% import _self as vsw %}

{% macro option_pill(option, activeOptionId, displayLabels) %}
    {% set fullName = option.translated.name ?? option.name %}
    {% set label = displayLabels[option.id]|default(fullName) %}
    <button type="button"
            class="vehicle-switcher__item{% if option.id == activeOptionId %} is-active{% endif %}"
            data-vehicle-switcher-item
            data-option-id="{{ option.id }}"
            title="{{ fullName|sw_sanitize }}"
            aria-pressed="{{ option.id == activeOptionId ? 'true' : 'false' }}">
        {{ label|sw_sanitize }}
    </button>
{% endmacro %}

{% macro all_pill(activeOptionId, allOptionLabel) %}
    <button type="button"
            class="vehicle-switcher__item vehicle-switcher__item--all{% if activeOptionId is null %} is-active{% endif %}"
            data-vehicle-switcher-item
            data-option-id=""
            aria-pressed="{{ activeOptionId is null ? 'true' : 'false' }}">
        {%- if allOptionLabel is not empty -%}
            {{ allOptionLabel|sw_sanitize }}
        {%- else -%}
            {{ 'vehicle-switcher.showAll'|trans|sw_sanitize }}
        {%- endif -%}
    </button>
{% endmacro %}

{% macro more_box(more, options, activeOptionId, displayLabels, modifier) %}
    {% import _self as vsw %}
    {% set moreOptions = options.filterByGroupId(more.get('groupId')) %}
    {% if moreOptions.count > 0 %}
        <details class="vehicle-switcher__more{% if modifier|default('') %} vehicle-switcher__more--{{ modifier }}{% endif %}"{% if more.get('open') %} open{% endif %}>
            <summary class="vehicle-switcher__more-toggle">{{ more.get('label')|sw_sanitize }}</summary>
            <div class="vehicle-switcher__track vehicle-switcher__track--more" role="group" aria-label="{{ more.get('label')|sw_sanitize }}">
                {% for option in moreOptions %}
                    {{ vsw.option_pill(option, activeOptionId, displayLabels) }}
                {% endfor %}
            </div>
        </details>
    {% endif %}
{% endmacro %}

{% block component_vehicle_switcher %}
    {% set layout = layout|default('bar') %}
    {% set moreGroupId = more ? more.get('groupId') : null %}
    <div class="vehicle-switcher vehicle-switcher--{{ layout }}"
         data-vehicle-switcher="true">

        {% block component_vehicle_switcher_inner %}

            {#  ----------  Gruppen untereinander  ----------  #}
            {% if layout == 'stacked' %}
                {% if showAllOption %}
                    <div class="vehicle-switcher__row vehicle-switcher__row--all">
                        <div class="vehicle-switcher__track">
                            {{ vsw.all_pill(activeOptionId, allOptionLabel) }}
                        </div>
                    </div>
                {% endif %}

                {% for groupId in groupOrder|filter(g => g != moreGroupId) %}
                    {% set groupLabel = groupLabels[groupId]|default('') %}
                    {% set groupOptions = options.filterByGroupId(groupId) %}

                    {% if groupOptions.count > 0 %}
                        {% block component_vehicle_switcher_row %}
                            <div class="vehicle-switcher__row">
                                {% if groupLabel is not empty %}
                                    <span class="vehicle-switcher__group-label">{{ groupLabel|sw_sanitize }}</span>
                                {% endif %}

                                <div class="vehicle-switcher__track" role="group"
                                     aria-label="{{ groupLabel is not empty ? groupLabel|sw_sanitize : 'vehicle-switcher.ariaLabel'|trans|sw_sanitize }}">
                                    {% for option in groupOptions %}
                                        {{ vsw.option_pill(option, activeOptionId, displayLabels) }}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endblock %}
                    {% endif %}
                {% endfor %}

                {% if more %}{{ vsw.more_box(more, options, activeOptionId, displayLabels) }}{% endif %}

            {#  ----------  Alles in einem Balken  ----------  #}
            {% else %}
                {% block component_vehicle_switcher_bar %}
                    <div class="vehicle-switcher__track" role="group"
                         aria-label="{{ 'vehicle-switcher.ariaLabel'|trans|sw_sanitize }}">

                        {% if showAllOption %}
                            {{ vsw.all_pill(activeOptionId, allOptionLabel) }}
                        {% endif %}

                        {% set currentGroupId = null %}
                        {% for option in options|filter(o => o.groupId != moreGroupId) %}
                            {% if option.groupId != currentGroupId %}
                                {% set currentGroupId = option.groupId %}
                                {% set groupLabel = groupLabels[option.groupId]|default('') %}
                                {% if groupLabel is not empty %}
                                    <span class="vehicle-switcher__group-label">{{ groupLabel|sw_sanitize }}</span>
                                {% endif %}
                            {% endif %}

                            {{ vsw.option_pill(option, activeOptionId, displayLabels) }}
                        {% endfor %}

                        {# Ab Tablet-Breite: „Weitere Fahrzeuge“ am Ende der Kachelreihe statt in einer eigenen Zeile #}
                        {% if more %}{{ vsw.more_box(more, options, activeOptionId, displayLabels, 'inline') }}{% endif %}
                    </div>

                    {# Handy (Leiste scrollt seitlich): Aufklapper unter der Leiste #}
                    {% if more %}{{ vsw.more_box(more, options, activeOptionId, displayLabels, 'below') }}{% endif %}
                {% endblock %}
            {% endif %}

        {% endblock %}

        {% block component_vehicle_switcher_description %}
            {% set vswRoute = activeRoute|default(app.request.attributes.get('_route')) %}
            {% set vswDescAllowed = descriptionListingOnly is not defined
                or not descriptionListingOnly
                or vswRoute in ['frontend.navigation.page', 'frontend.search.page', 'frontend.home.page'] %}

            {% if activeDescription is not empty and vswDescAllowed %}
                <div class="vehicle-switcher__description {{ descriptionCssClass|default('') }}">
                    {% block component_vehicle_switcher_description_inner %}
                        {{ activeDescription|sw_sanitize }}
                    {% endblock %}
                </div>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
